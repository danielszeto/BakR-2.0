<%= render "shared/errors", record: user %>
<%= form_with model: user, class: "edit-form" do |form| %>
  <div class="form-row">
    <div class="field">
      <%= form.label :first_name, "First name or bakery name" %>
      <%= form.text_field :first_name, required: true, maxlength: 80, autocomplete: "given-name" %>
    </div>
    <div class="field">
      <%= form.label :last_name, "Last name (optional)" %>
      <%= form.text_field :last_name, maxlength: 80, autocomplete: "family-name" %>
    </div>
  </div>
  <div class="field">
    <%= form.label :location, "City or neighborhood" %>
    <%= form.text_field :location, required: true, maxlength: 80, autocomplete: "address-level2" %>
  </div>
  <% if user.new_record? %>
    <div class="field">
      <%= form.label :email, "Sign-in email" %>
      <%= form.email_field :email, required: true, maxlength: 254, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= form.label :password, "Password (12 characters or more)" %>
      <%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>
  <% end %>
  <div class="field">
    <%= form.label :contact_email, "Contact email (optional)" %>
    <%= form.email_field :contact_email, maxlength: 254, aria: { describedby: "contact-hint" } %>
    <small class="hint" id="contact-hint">Signed-in buyers can use this address to email you about available listings.</small>
  </div>
  <div class="field">
    <%= form.label :bio, "About you (optional)" %>
    <%= form.text_area :bio, rows: 4, maxlength: 1000 %>
  </div>
  <%= form.submit user.persisted? ? "Save profile" : "Create account", class: "button" %>
<% end %>
