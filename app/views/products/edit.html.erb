<% content_for :title, "Edit listing" %>
<div class="form-panel">
  <%= link_to "← View listing", @product, class: "back-link" %>
  <h1>Edit listing</h1>
  <%= render "form", product: @product %>
  <details class="delete-panel">
    <summary>Delete listing</summary>
    <p>This permanently removes the listing from your profile and the marketplace.</p>
    <%= button_to "Permanently delete", @product, method: :delete, class: "button secondary" %>
  </details>
</div>
